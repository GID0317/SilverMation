<UserControl x:Class="SilverMation.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SilverMation"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:muxc="clr-namespace:iNKORE.UI.WPF.Modern.Controls;assembly=iNKORE.UI.WPF.Modern.Controls"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <muxc:InfoBar
                x:Name="UpdateInfobar"
                Panel.ZIndex="1"
                Severity="Warning"
                Title="Update Available"
                Message="A new update is available with some fixes and improvements! We recommend you download the latest version for a better experience. Click the button to download."
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Margin="10">
                <muxc:InfoBar.ActionButton>
                    <Button Content="Download" Click="InfoBarButton_Click" />
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>

            <StackPanel Orientation="Vertical" Margin="20, 20, 20, 0">
                <Border CornerRadius="10" BorderBrush="Transparent" BorderThickness="1" Height="180">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/IMG_SilverMation_Banner.png" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Vertical" Background="Transparent" Margin="10">
                            <TextBlock Text="SilverMation" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10, 10, 0, 0" Foreground="White"/>
                            <TextBlock Text="That's more like it." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 0, 0, 0" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ui:SettingsExpander x:Name="Expander_Language"
                     Margin="0,20,0,20"
                     Header="SilverMation, Start now!"
                     Description="Start the Silvermation Automation monitoring.">
                    <!-- Header Icon -->
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon Glyph=""/>
                    </ui:SettingsExpander.HeaderIcon>

                    <!-- Additional header content (e.g. the toggle button) -->
                    <ToggleButton x:Name="StartMonitoringToggleButton" 
                  Checked="StartMonitoringToggleButton_Checked" 
                  Unchecked="StartMonitoringToggleButton_Unchecked"
                  HorizontalAlignment="Right" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon x:Name="StartMonitoringToggleButtonIcon" Glyph=""/>
                            <TextBlock x:Name="StartMonitoringToggleButtonText" Text="Start" Margin="5,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Settings items grouped as cards -->
                    <ui:SettingsExpander.Items>
                        <!-- Card for trigger interval -->
                        <ui:SettingsCard Header="Trigger Interval (ms)"
                         Description="Set the interval in milliseconds for the trigger.">
                            <TextBox x:Name="IntervalTextBox" 
                     Width="100" Height="30" 
                     Text="50" 
                     TextChanged="IntervalTextBox_TextChanged"/>
                        </ui:SettingsCard>

                        <!-- Card for picking the executable directory -->
                        <ui:SettingsCard Header="Select HonkaiStarRail.exe Directory"
                         Description="No executable selected at the moment.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ExeLocation" 
                           VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <Button Content="Browse the target" 
                        Click="SelectTargetExecutable_Click"/>
                            </StackPanel>
                        </ui:SettingsCard>

                        <!-- Card for preview window -->
                        <ui:SettingsCard Header="Show the Preview Window"
                         Description="Display the preview window for monitoring.">
                            <Button Content="Show Preview" Click="ShowPreview_Click"/>
                        </ui:SettingsCard>

                        <!-- Card for auto-show toggle -->
                        <ui:SettingsCard Header="Auto Show Preview On Start"
                         Description="Automatically show the preview window when the application starts.">
                            <ui:ToggleSwitch x:Name="AutoShowPreviewToggleSwitch" 
                             Toggled="AutoShowPreviewToggleSwitch_Toggled"/>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
