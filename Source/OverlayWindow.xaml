<Window x:Class="SilverMation.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverlayWindow" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20, 20, 20, 245">
        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="300" Height="155">
            <StackPanel x:Name="LogStackPanel" Orientation="Vertical">
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
