<UserControl x:Class="SilverMation.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SilverMation"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ui:ScrollViewerEx VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}"/>

        <!-- Theme Settings Card -->
        <ui:SettingsCard 
            Header="Choose app theme"
            Description="Select which app theme to display"
            IsEnabled="True"
            Margin="0,20,0,0">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Glyph="&#xE790;"/>
            </ui:SettingsCard.HeaderIcon>
            <ComboBox x:Name="ThemeComboBox" 
                     SelectionChanged="ThemeComboBox_SelectionChanged" 
                     FontWeight="Regular">
                <ComboBoxItem Content="Light" FontWeight="Regular"/>
                <ComboBoxItem Content="Dark" FontWeight="Regular"/>
                <ComboBoxItem Content="Use system setting" FontWeight="Regular"/>
            </ComboBox>
        </ui:SettingsCard>

        <TextBlock Text="About" Margin="10,20,10,10" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}"/>
        
        <!-- About Settings Expander -->
        <ui:SettingsExpander x:Name="Expander_Language"
            Header="SilverMation"
            Description="Copyright © GID Under MIT License. All rights reserved.">
            <ui:SettingsExpander.HeaderIcon>
                <Image Source="/Assets/IMG_SilverMation_Icon.png"
                       Width="20" Height="20" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:SettingsExpander.HeaderIcon>
            <TextBlock Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorSecondaryBrushKey}}"
                      Text="Version 1.2.0" />
            <ui:SettingsExpander.Items>
                <ui:SettingsCard 
                    Header="Send a Feedback, File a bug or contribute to the project">
                    <ui:HyperlinkButton 
                        Content="Go to the page"
                        NavigateUri="https://github.com/GID0317/SilverMation" />
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>
    </StackPanel>
    </ui:ScrollViewerEx>
</UserControl>
