<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\IMG_SilverMation_Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>DeNesis</Company>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tessdata\**" />
    <EmbeddedResource Remove="tessdata\**" />
    <None Remove="tessdata\**" />
    <Page Remove="tessdata\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\IMG_SilverMation_Banner.png" />
    <None Remove="Assets\IMG_SilverMation_Icon.ico" />
    <None Remove="Assets\IMG_SilverMation_Icon.png" />
    <None Remove="Assets\OneMoreTimeBtn.png" />
    <None Remove="PaddleOCRModels\en_dict.txt" />
    <None Remove="PaddleOCRModels\en_number_mobile_v2.0_rec\inference.pdiparams" />
    <None Remove="PaddleOCRModels\en_number_mobile_v2.0_rec\inference.pdiparams.info" />
    <None Remove="PaddleOCRModels\en_number_mobile_v2.0_rec\inference.pdmodel" />
    <None Remove="PaddleOCRModels\en_PP-OCRv3_det\inference.pdiparams" />
    <None Remove="PaddleOCRModels\en_PP-OCRv3_det\inference.pdiparams.info" />
    <None Remove="PaddleOCRModels\en_PP-OCRv3_det\inference.pdmodel" />
    <None Remove="PaddleOCRModels\en_PP-OCRv3_rec\inference.pdiparams" />
    <None Remove="PaddleOCRModels\en_PP-OCRv3_rec\inference.pdiparams.info" />
    <None Remove="PaddleOCRModels\en_PP-OCRv3_rec\inference.pdmodel" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.openblas" Version="2.6.1" />
    <PackageReference Include="Sdcb.PaddleOCR" Version="2.7.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\IMG_SilverMation_Banner.png" />
    <Resource Include="Assets\IMG_SilverMation_Icon.ico" />
    <Resource Include="Assets\IMG_SilverMation_Icon.png" />
    <Resource Include="Assets\OneMoreTimeBtn.png" />
    <Content Include="PaddleOCRModels\en_dict.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_number_mobile_v2.0_rec\inference.pdiparams">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_number_mobile_v2.0_rec\inference.pdiparams.info">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_number_mobile_v2.0_rec\inference.pdmodel">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_PP-OCRv3_det\inference.pdiparams">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_PP-OCRv3_det\inference.pdiparams.info">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_PP-OCRv3_det\inference.pdmodel">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_PP-OCRv3_rec\inference.pdiparams">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_PP-OCRv3_rec\inference.pdiparams.info">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PaddleOCRModels\en_PP-OCRv3_rec\inference.pdmodel">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
